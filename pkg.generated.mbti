pub fn TlsClientOptions::new(String, verify_certificates? : Bool, ca_pem_file? : String?) -> Self

pub struct TopicMetadata {
  name : String
  error_code : Int
  topic_id : Uuid
  is_internal : Bool
  partitions : Array[PartitionInfo]
}

pub(all) struct TopicPartitionCursor {
  topic_name : String
  partition_index : Int
} derive(@debug.Debug)

pub(all) struct TxnOffset {
  partition : Int
  offset : Int64
} derive(@debug.Debug)

pub struct TxnPartitionResult {
  topic : String
  partition : Int
  error_code : Int
} derive(@debug.Debug)

pub struct UnregisterBrokerResult {
  error_code : Int
  error_message : String?
} derive(@debug.Debug)

pub struct Uuid {
  bytes : Bytes
} derive(Compare, Eq, Hash, @debug.Debug)
pub fn Uuid::from_bytes(Bytes) -> Self raise @buf.DecodeError
pub fn Uuid::parse(String) -> Self raise @buf.DecodeError
pub fn Uuid::to_bytes(Self) -> Bytes
pub fn Uuid::zero() -> Self
pub impl Show for Uuid

// Type aliases
pub type MetricsProvider = () -> Bytes

